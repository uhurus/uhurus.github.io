---
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"
import Hero from "../components/home/Hero.astro"
import Problema from "../components/home/Problema.astro"
import Modelo from "../components/home/Modelo.astro"
import Personas from "../components/home/Personas.astro"
import Capacidades from "../components/home/Capacidades.astro"
import LoQueConstruimos from "../components/home/LoQueConstruimos.astro"
import LoQueCambia from "../components/home/LoQueCambia.astro"
import Metodologia from "../components/home/Metodologia.astro"
import Resultados from "../components/home/Resultados.astro"
import Fintech from "../components/home/Fintech.astro"
import Contacto from "../components/home/Contacto.astro"

const sections = (await getCollection("home")).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<Layout>
  {sections.map((section) => {
    const track = section.data.type
    switch (section.data.type) {
      case "hero":
        return <div data-track={track}><Hero {...section.data} /></div>
      case "problema":
        return <div data-track={track}><Problema {...section.data} /></div>
      case "modelo":
        return <div data-track={track}><Modelo {...section.data} /></div>
      case "personas":
        return <div data-track={track}><Personas {...section.data} /></div>
      case "capacidades":
        return <div data-track={track}><Capacidades {...section.data} /></div>
      case "loQueConstruimos":
        return <div data-track={track}><LoQueConstruimos {...section.data} /></div>
      case "loQueCambia":
        return <div data-track={track}><LoQueCambia {...section.data} /></div>
      case "metodologia":
        return <div data-track={track}><Metodologia {...section.data} /></div>
      case "resultados":
        return <div data-track={track}><Resultados {...section.data} /></div>
      case "experiencia":
        return <div data-track={track}><Fintech {...section.data} /></div>
      case "contacto":
        return <div data-track={track}><Contacto {...section.data} /></div>
      default:
        const _exhaustive: never = section.data.type
        return null
    }
  })}

  <script>
    // Smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener("click", function (e) {
        const href = this.getAttribute("href")
        if (href && href.startsWith("#") && document.querySelector(href)) {
          e.preventDefault()
          document.querySelector(href)?.scrollIntoView({ behavior: "smooth" })
          document.getElementById("mobile-menu")?.classList.remove("h-65")
          document.getElementById("mobile-menu")?.classList.add("h-0")
        }
      })
    })
  </script>
</Layout>
