---
import Footer from "../components/chrome/Footer.astro"
import Header from "../components/chrome/Header.astro"
import Seo from "@jdevalk/astro-seo-graph/Seo.astro"

import "../styles/app.css"
import { graphForPage, SITE_URL } from "../lib/schema"

const {
  title       = "Laboratorio de producto e innovación",
  description = "Laboratorio de producto en Bilbao: apps móviles, desarrollo web, MVP y software a medida para empresas de toda España.",
  ogImage     = "/banner.jpg",
  ogType      = "website",
  datePublished,
  dateModified,
} = Astro.props

const pathname     = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "") || "/"
const canonicalURL = new URL(pathname, SITE_URL).toString()
const siteTitle    = title.includes("uhurus") ? title : `${title} | uhurus`

const graph = graphForPage({ title, description, url: canonicalURL, datePublished, dateModified })
---

<!doctype html>
<html
  lang="es"
  class="scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <Seo
      title={siteTitle}
      description={description}
      canonical={canonicalURL}
      siteName="uhurus"
      locale="es_ES"
      ogType={ogType}
      ogImage={ogImage}
      ogLocale="es-ES"
      ogImageAlt={`uhurus - ${title}`}
      twitter={{
        card: "summary_large_image",
      }}
      graph={graph}
      extraLinks={[
        { rel: "icon", type: "image/png", href: "/favicon.ico" },
        { rel: "sitemap", href: "/sitemap-index.xml" },
      ]}
    />

    <link
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      /></noscript
    >

    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=DM+Sans:wght@100..1000&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=DM+Sans:wght@100..1000&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      /></noscript
    >

    <slot name="head" />
  </head>
  <body
    class="font-sans antialiased"
    data-theme="uhurus"
  >
    <Header />
    <slot />
    <Footer />
    <script>
      // Appear on scroll — global (responde a prefers-reduced-motion vía CSS)
      const appearEls = document.querySelectorAll("[data-appear]")
      if ("IntersectionObserver" in window && appearEls.length) {
        const io = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-appeared")
                io.unobserve(entry.target)
              }
            })
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        )
        appearEls.forEach(el => io.observe(el))
      } else {
        appearEls.forEach(el => el.classList.add("is-appeared"))
      }
    </script>
    <script>
      import { initScrollDepth, initSectionTracking, initClickTracking } from "../lib/umami-track"
      initScrollDepth()
      initSectionTracking()
      initClickTracking()
    </script>
    {
      import.meta.env.PROD ? (
        <script
          defer
          is:inline
          src="https://argos.uhurus.com/script.js"
          data-website-id="58bd326d-32b9-44c2-af06-b86499a89f9f"
        />
      ) : (
        <script />
      )
    }
  </body>
</html>
