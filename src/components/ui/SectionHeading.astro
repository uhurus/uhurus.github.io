---
// SectionHeading — eyebrow de anotación + H2 + intro.
// Mantiene el ritmo de "anotación de laboratorio" en toda la web.
interface Props {
  eyebrow         : string
  title           : string
  intro?          : string
  align?          : "center" | "split"
  containerClass? : string
  h2Class?        : string
  introClass?     : string
}

const {
  eyebrow,
  title,
  intro,
  align = "center",
  containerClass,
  h2Class = "",
  introClass = "",
} = Astro.props

const container =
  containerClass ??
  (align === "center"
    ? "max-w-3xl mx-auto text-center mb-16"
    : "flex flex-wrap justify-between gap-8 mb-16")

const introBase =
  introClass ||
  (align === "center"
    ? "text-lg text-base-content/70 leading-relaxed mt-6"
    : "text-lg text-base-content/70 leading-relaxed max-w-prose")

const h2ClassList = ["h2 mt-4 text-balance", h2Class]
---

{
  align === "center" ? (
    <div class={container} data-appear>
      <span class="eyebrow">{eyebrow}</span>
      <h2 class:list={h2ClassList}>
        <Fragment set:html={title} />
      </h2>
      {intro && <p class={introBase}><Fragment set:html={intro} /></p>}
    </div>
  ) : (
    <div class={container}>
      <div class="w-full lg:w-1/3">
        <span class="eyebrow">{eyebrow}</span>
        <h2 class:list={h2ClassList}>
          <Fragment set:html={title} />
        </h2>
      </div>
      {intro && (
        <div class="w-full lg:w-1/2 flex flex-col justify-center">
          <p class={introBase}><Fragment set:html={intro} /></p>
        </div>
      )}
    </div>
  )
}
