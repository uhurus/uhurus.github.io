---
interface Props {
  icon: string
  title: string
  description: string
  variant?: "cell" | "card"
  animateLine?: boolean
}

const {
  icon,
  title,
  description,
  variant = "cell",
  animateLine = false,
} = Astro.props

const lineClass = animateLine
  ? "mb-4 h-1 w-8 rounded-full bg-live/60 transition-all duration-300 group-hover:w-16"
  : "mb-4 h-1 w-8 rounded-full bg-live/60"
---

{
  variant === "cell" ? (
    <div class="group flex items-start gap-6 border-b border-r border-edge p-8 md:p-10 transition-colors duration-300 hover:bg-surface/40">
      <div class="shrink-0 w-20 flex justify-center">
        <i
          class={`fas ${icon} text-3xl text-accent mt-5`}
          aria-hidden="true"
        />
      </div>
      <div class="flex flex-col">
        <div class={lineClass} />
        <h3 class="h3 mb-3">
          {title}
        </h3>
        <p class="text-base-content/70 leading-relaxed">{description}</p>
      </div>
    </div>
  ) : (
    <div class="relative overflow-hidden rounded-2xl border border-edge bg-ink p-8">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-16 flex justify-center">
          <i
            class={`fas ${icon} text-2xl text-accent mt-4`}
            aria-hidden="true"
          />
        </div>
        <div class="flex flex-col">
          <span class={lineClass} />
          <h3 class="h3 text-xl mb-3">
            {title}
          </h3>
          <p class="text-base-content/70 leading-relaxed">{description}</p>
        </div>
      </div>
    </div>
  )
}
