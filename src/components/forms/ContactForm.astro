<div class="panel">
  <div class="panel-head">
    <span class="panel-dot bg-amber"></span>
    <span class="instrument text-label-sm tracking-widest text-base-content/70"
      >ponte en contacto</span
    >
  </div>
  <div class="p-7">
    <div class="h3 mb-1">Cuéntanos tu idea</div>
    <p class="text-sm text-base-content/60 mb-6">
      Déjanos tus datos y te contactaremos.
    </p>
    <form
      id="contact-form"
      method="POST"
    >
      <input
        type="hidden"
        name="origin"
        value="uhurus.com"
      />
      <fieldset class="fieldset mb-5">
        <legend class="fieldset-legend instrument text-label tracking-widest"
          >nombre</legend
        >
        <input
          required
          type="text"
          name="name"
          aria-label="nombre"
          class="input w-full rounded-sm"
        />
      </fieldset>
      <fieldset class="fieldset mb-5">
        <legend class="fieldset-legend instrument text-label tracking-widest"
          >email</legend
        >
        <input
          required
          type="email"
          aria-label="email"
          name="email"
          class="input w-full rounded-sm"
        />
      </fieldset>
      <fieldset class="fieldset mb-5">
        <legend class="fieldset-legend instrument text-label tracking-widest"
          >¿cómo podemos ayudarte?</legend
        >
        <textarea
          required
          aria-label="describe como podemos ayudarte"
          rows="4"
          name="message"
          class="w-full textarea rounded-sm"
        ></textarea>
      </fieldset>

      <fieldset class="fieldset mb-5">
        <label class="label cursor-pointer justify-start gap-2">
          <input
            name="accept-terms"
            id="accept-terms"
            type="checkbox"
            class="checkbox checkbox-sm rounded-sm"
          />
          <span class="text-sm"
            >Acepto la <a
              target="_blank"
              href="/legal/politica-privacidad"
              class="link link-accent"
              >Política de privacidad</a
            ></span
          >
        </label>
      </fieldset>
      <button
        disabled
        id="submit"
        type="submit"
        class="btn btn-accent w-full rounded-sm"
      >
        Enviar mensaje
        <span class="loading loading-spinner loading-sm hidden"></span>
        <span class="fa-check hidden"></span>
      </button>
      <label class="text-error text-xs ml-2 hidden"
        >Ha habido un error en el envío del formulario.</label
      >
    </form>
  </div>
</div>
<script>
  const form = document.getElementById("contact-form") as HTMLFormElement
  const submit = document.getElementById("submit") as HTMLButtonElement
  const loading = submit
    .getElementsByClassName("loading")
    .item(0) as HTMLElement
  const success = submit
    .getElementsByClassName("fa-check")
    .item(0) as HTMLElement
  const error = form.getElementsByClassName("text-error").item(0) as HTMLElement
  let sent = false

  form.addEventListener("submit", async function submitForm(event: Event) {
    event.preventDefault()
    if (sent) return

    const data = new FormData(event.target as HTMLFormElement)
    const text = [...data.entries()].reduce(
      (result, [key, value]) => result + `${key}: ${value}\n`,
      "",
    )

    loading.classList.toggle("hidden")

    await new Promise(resolve => setTimeout(resolve, 500))

    const url = new URL(
      "https://backsheet.dev/p/xk300r-gxbwb2?text=" + encodeURIComponent(text),
    )
    const response = await fetch(url, {
      credentials: "omit",
    })
      .then(response => response.json())
      .catch(error => {})

    loading.classList.toggle("hidden")
    success.classList.replace("hidden", "fas")
    const textElement = submit.childNodes.item(0) as HTMLElement

    if (!response) {
      textElement.textContent = "Ha habido un error"
      submit.classList.replace("btn-accent", "btn-error")
      success.classList.replace("fa-check", "fa-x")
      error?.classList.toggle("hidden")
    } else textElement.textContent = "Enviado ✓"

    return (sent = true)
  })

  document
    .getElementById("accept-terms")
    ?.addEventListener("click", function toggleSubmit(event: Event) {
      const submit = document.querySelector("#submit") as HTMLButtonElement
      const check = event.target as HTMLInputElement
      submit.disabled = !check.checked
    })
</script>
