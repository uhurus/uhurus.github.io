---
import Question from "./Question.astro"

const questions = [
  {
    question: "¿Cómo es vuestro proceso de desarrollo de productos digitales?",
    answer: "Trabajamos como el equipo de producto que te falta, solo cuando lo necesitas:",
    reasons: [
      "<span class='font-bold'>Validamos construyendo</span>: Sacamos una versión real en semanas y los datos deciden.",
      "<span class='font-bold'>Desarrollo iterativo</span>: Entregas continuas para que veas progreso real.",
      "<span class='font-bold'>Métricas desde el día 1</span>: decidimos con datos, no a ojo.",
    ],
  },
  {
    question: "¿Cómo podéis ayudarnos con la modernización de sistemas legacy?",
    answer: "Probamos ideas nuevas sin tocar tu sistema principal:",
    reasons: [
      "<span class='font-bold'>Reemplazo por fases</span>: Actualizamos tu tecnología de forma segura y sin parar la operativa.",
      "<span class='font-bold'>Nuevas líneas de negocio</span>: Portales, automatizaciones o nuevos productos digitales.",
      "<span class='font-bold'>Sin arriesgar lo que factura</span>: Migramos lo viejo sin tirar lo que ya funciona.",
    ],
  },
  {
    question: "¿Seguís especializados en banca y pagos?",
    answer: "Llevamos años en el sector y aplicamos esa exigencia a cualquier producto:",
    reasons: [
      "<span class='font-bold'>Exigencia del sector</span>: Conocemos los problemas de este sector porque los hemos resuelto, no porque los hayamos leído.",
      "<span class='font-bold'>Lógicas de pago complejas</span>: Si tu proyecto necesita repartos de pagos entre varios, sabemos hacerlo sin dolor de cabeza.",
      "<span class='font-bold'>Seguridad por defecto</span>: Protegemos los datos desde el diseño, no al final.",
    ],
  },
  {
    question: "¿Qué incluye vuestro servicio de MVP?",
    answer: "Es la forma más rápida y efectiva de probar tu idea en el mercado real:",
    reasons: [
      "<span class='font-bold'>Enfoque en lo esencial</span>: Desarrollamos solo lo crítico para validar la demanda real.",
      "<span class='font-bold'>Lanzamiento ágil</span>: En semanas en lugar de meses.",
      "<span class='font-bold'>Feedback de mercado</span>: Consigues los primeros clientes o inversores con algo real.",
    ],
  },
  {
    question: "¿Hacéis seguimiento o mantenimiento después de lanzar el producto?",
    answer: "No te abandonamos tras el lanzamiento. Ofrecemos mejora continua:",
    reasons: [
      "<span class='font-bold'>Análisis de métricas</span>: Evaluamos qué partes del producto funcionan mejor.",
      "<span class='font-bold'>Mantenimiento proactivo</span>: Aseguramos el rendimiento y la escalabilidad.",
      "<span class='font-bold'>Iteración continua</span>: Evolucionamos la herramienta con datos de uso real.",
    ],
  }
]
---

<div class="join join-vertical w-full">
  {
    questions.map(({ question, answer, reasons }) => (
      <Question
        question={question}
        answer={answer}
        reasons={reasons}
      />
    ))
  }
</div>
