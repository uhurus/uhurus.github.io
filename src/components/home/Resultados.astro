---
import IconChip from "../ui/IconChip.astro"
import SectionHeading from "../ui/SectionHeading.astro"

interface Item {
  title: string
  description: string
}

interface Props {
  eyebrow?: string
  h2?: string
  intro?: string
  items?: Item[]
}

const { eyebrow, h2, intro, items = [] } = Astro.props
---

<section class="section bg-base-100">
  <div class="absolute inset-0 opacity-5 bg-[radial-gradient(circle_at_50%_50%,#00d492,transparent_60%)]" aria-hidden="true"></div>

  <div class="shell relative z-10">
    <SectionHeading
      eyebrow={eyebrow}
      title={h2}
      intro={intro}
      align="split"
    />

    <div class="divide-y divide-edge border-y border-edge" data-appear>
      {items.map((item) => (
        <div class="group flex flex-col md:flex-row md:items-center gap-3 md:gap-10 py-8 transition-colors duration-300">
          <IconChip icon="fa-check" variant="live" size="sm" />
          <h3 class="h3 md:w-80 shrink-0">
            {item.title}
          </h3>
          <p class="text-base-content/70 leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
