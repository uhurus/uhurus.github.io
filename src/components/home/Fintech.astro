---
// EXPERIENCIA — rigor de banca y pagos, sin métricas inventadas.
// copy: .planning/copies/home.md (Fintech)
import Card from "../ui/Card.astro"
import IconChip from "../ui/IconChip.astro"

interface Item {
  title: string
  description: string
  icon?: string
}

interface Props {
  eyebrow?: string
  h2?: string
  text?: string
  items?: Item[]
  panel?: string
}

const { eyebrow, h2, text, items = [], panel } = Astro.props
---

<section class="section bg-base-100">
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_30%_50%,#00d492,transparent_60%)]" aria-hidden="true"></div>

  <div class="shell relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center" data-appear>
      <div>
        <span class="eyebrow">
          {eyebrow}
        </span>
        <h2 class="h2 mt-4 mb-6">
          <Fragment set:html={h2} />
        </h2>
        <p class="text-lg text-base-content/70 leading-relaxed mb-8">
          <Fragment set:html={text} />
        </p>

        <div class="grid sm:grid-cols-2 gap-6">
          {items.map((item) => (
          <div class="flex items-start gap-4">
            <IconChip icon={item.icon} className="mt-1.5" />
            <div>
              <h4 class="font-bold mb-1">{item.title}</h4>
              <p class="text-sm text-base-content/60 leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
          ))}
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-4 bg-live/10 rounded-3xl blur-2xl opacity-50" aria-hidden="true"></div>
        <Card padding="md" className="relative">
          <p class="font-display text-xl text-base-content/70 leading-relaxed">
            {panel}
          </p>
        </Card>
      </div>
    </div>
  </div>
</section>
