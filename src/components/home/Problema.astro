---
// EL PROBLEMA — las 6 cosas que las consultoras hacen mal,
// dispuestas como nube de tags bajo el titular.
// copy: .planning/copies/home.md (EL PROBLEMA)

interface Item {
  title: string
  description: string
}

interface Props {
  eyebrow?: string
  h2?: string
  intro?: string
  items?: Item[]
}

const { eyebrow, h2, intro, items = [] } = Astro.props

// Tokens de presentación por posición — nunca en datos.
const sizes = ["sm", "md", "sm", "sm", "lg", "sm"]
const rotations = ["-rotate-3", "rotate-2", "-rotate-1", "rotate-3", "-rotate-2", "rotate-1"]

const sizeClasses = {
  sm: "px-4 py-2 text-sm max-w-52",
  md: "px-5 py-2.5 text-base max-w-60",
  lg: "px-6 py-3 text-lg max-w-68",
}
---

<section id="problema" class="section bg-base-100">
  <div class="shell">
    <div
      class="flex flex-col items-center text-center"
      data-appear
    >
      <span class="eyebrow mb-4">{eyebrow}</span>
      <h2
        class="h2 text-balance max-w-[16ch]"
      >
        <Fragment set:html={h2} />
      </h2>
      <p
        class="text-xl text-base-content/70 leading-relaxed max-w-[44ch] mt-6"
      >
        {intro}
      </p>

      <!-- Nube de tags -->
      <div
        class="mt-16 flex flex-wrap justify-center gap-4 max-w-4xl"
        data-appear
      >
        {
          items.map((item, index) => (
            <span
              class:list={[
                `inline-flex flex-col gap-1 rounded-2xl border border-edge bg-ink shadow-card ${rotations[index % rotations.length]}`,
                sizeClasses[sizes[index % sizes.length]],
              ]}
            >
              <strong class="font-display font-bold leading-tight text-base-content">
                {item.title}
              </strong>
              <span class="text-xs leading-snug text-base-content/60">
                {item.description}
              </span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
